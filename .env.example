# Required for hosted deployment
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://username:password@host:5432/database
BOOTSTRAP_ADMIN_USERNAME=choose-admin-username
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-of-at-least-16-characters

# SMTP email alerts (use provider app-password, not your personal mailbox password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=provider-app-password
ALERT_EMAIL=management@example.com
